# Copy to .env (which is git-ignored) and fill in. Never commit real values.
DATABASE_URL=postgresql://edgar:CHANGE_ME@localhost:5433/edgar
POSTGRES_PASSWORD=CHANGE_ME
GEMINI_API_KEY=            # generation (free tier is fine for development)

# gateway (see README "Configuration")
EA_ENVIRONMENT=dev          # dev | prod
EA_AUTH=on                  # off is accepted only when EA_ENVIRONMENT=dev
EA_API_KEYS=                # name:sha256hex,... create with: uv run python -m services.gateway.keys NAME
EA_EMBEDDER=local           # must match the model the corpus was embedded with
# EA_RATE_PER_MIN=20
# EA_AGENT_DAILY_CAP=50
# EA_AGENT_MAX_STEPS=8
# EA_AGENT_MAX_SECONDS=120
